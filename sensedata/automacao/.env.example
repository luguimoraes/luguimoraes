# ---------------------------------------------------------------- API
# Confirme o header de autenticação no ReDoc do seu tenant:
# https://api.sensedata.io/v2/redoc
SENSEDATA_API_KEY=
SENSEDATA_BASE_URL=https://api.sensedata.io/v2
SENSEDATA_HEADER_AUTH=api_key

# ----------------------------------------------- nomes internos dos campos
# ATENÇÃO: use o nome INTERNO, não o de exibição. O SenseData sufixa quando há
# colisão ("CS Feeling" pode virar cs_feeling_2). Confira em
# Configurações -> Campos Customizados antes do primeiro run — nome errado não
# levanta erro, só grava em lugar nenhum.
CAMPO_FEELING=cs_feeling
CAMPO_DT_ANOTACAO=dt_ultima_anotacao_cs
CAMPO_DT_FEELING=dt_ultima_atualizacao_cs_feeling
CAMPO_DIAS=dias_sem_atualizacao_cs
CAMPO_NIVEL=nivel_alerta_inatividade
CAMPO_EMAIL_LIDER=email_lider_cs

# --------------------------------------------------------------- anotações
# Autores cujas anotações NÃO contam como acompanhamento de CS: integrações,
# bots, sincronizações. Se elas contarem, o contador nunca chega a 90 e a régua
# morre em silêncio.
AUTORES_IGNORADOS=integracao@suaempresa.com.br,bot-zendesk,sync-nps

# --------------------------------------------------------------- liderança
# Mapa CS -> e-mail do líder, para a cópia dinâmica em D+105 e D+120.
# Se a estrutura do time já estiver no seu DW, prefira ler de lá: evita deploy
# toda vez que alguém troca de time.
LIDER_POR_CS={"ana.silva":"lider1@suaempresa.com.br","joao.souza":"lider2@suaempresa.com.br"}

# ------------------------------------------------------------------ rollout
# Suprime disparos nos primeiros CARENCIA_INICIAL dias após DATA_ATIVACAO_REGRA.
# Os campos continuam sendo calculados e gravados normalmente — só o alerta
# fica retido. Dá ao time uma janela para preencher o CS Feeling antes de a
# régua começar a cobrar.
DATA_ATIVACAO_REGRA=2026-09-15
CARENCIA_INICIAL=30

# ------------------------------------------------------------------ estado
BANCO_CONTROLE=./controle_inatividade.sqlite
