# Credenciais e parâmetros da rotina comercial_da_conta (não versionar o .env real)
SENSEDATA_API_KEY=
SENSEDATA_BASE_URL=https://api.sensedata.io/v2

# Identificação do campo customizado na instância
SENSEDATA_CF_NAME=comercial_da_conta
SENSEDATA_CF_KEY_MODE=name          # name | id
SENSEDATA_CF_ID=                    # obrigatório quando SENSEDATA_CF_KEY_MODE=id
SENSEDATA_CF_VALUE_MODE=email       # email | name | id  (formato aceito pelo CF de lista de usuários)

# Tipos de contato tratados como responsável comercial
SENSEDATA_COMMERCIAL_TYPES=Comercial,Responsável Comercial,Executivo Comercial,Vendas

# Colunas do arquivo de Manutenção via CSV
SENSEDATA_CSV_ID_COLUMN=id_original
SENSEDATA_CSV_FIELD_COLUMN=comercial_da_conta
